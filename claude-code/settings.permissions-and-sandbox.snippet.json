{
  "permissions": {
    "defaultMode": "auto",
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git fetch",
      "git fetch *",
      "git pull",
      "git pull *",
      "git push",
      "git push *",
      "git ls-remote *",
      "git remote update",
      "git remote update *",
      "git submodule update *",
      "git clone *"
    ],
    "filesystem": {
      "allowRead": [
        "~/.nvm",
        "~/.npm",
        "~/.cache/vite",
        "~/.cache/pip"
      ],
      "allowWrite": [
        "~/.npm",
        "~/.cache/vite",
        "~/.cache/pip",
        "~/Code"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.config/gh",
        "~/.local/share/keyrings",
        "~/.npmrc",
        "~/Documents",
        "~/Downloads",
        "~/Pictures",
        "~/Videos",
        "~/Desktop",
        "~/Music"
      ]
    },
      "network": {
      "tlsTerminate": {},
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "mask",
          "injectHosts": ["api.github.com", "uploads.github.com"]
        }
      ]
    }
  }
}